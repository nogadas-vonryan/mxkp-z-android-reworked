<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- You can make custom themes with custom style items for activities and views here. -->

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <!-- Custom style items for main theme goes here. -->
        <item name="android:colorBackground">#000000</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#C0DEFF</item>
        <item name="android:colorControlNormal">#B4B4B4</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">#1B1B1B</item>
        <item name="android:windowBackground">#1B1B1B</item>
        <item name="android:textColorPrimary">#D2D2D2</item>
        <item name="android:textColorSecondary">#969696</item>
        <item name="android:buttonStyle">@style/LauncherDialogButton</item>
        <item name="android:alertDialogTheme">@style/LauncherDialogTheme</item>
        <item name="android:popupMenuStyle">@style/LauncherPopupMenu</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#1B1B1B</item>
        <item name="android:navigationBarColor">#1B1B1B</item>
    </style>
    <style name="LauncherDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#C0DEFF</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="LauncherDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#C0DEFF</item>
        <item name="android:colorControlNormal">#B4B4B4</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#D2D2D2</item>
        <item name="android:textColorSecondary">#969696</item>
        <item name="android:buttonStyle">@style/LauncherDialogButton</item>
        <item name="android:windowBackground">@drawable/launcher_dialog</item>
    </style>
    <style name="LauncherPopupMenu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/launcher_popup</item>
    </style>
    <style name="GamepadButton" />
</resources>
