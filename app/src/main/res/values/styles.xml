<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- You can make custom themes with custom style items for activities and views here. -->

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <!-- Custom style items for main theme goes here. -->
        <item name="android:colorBackground">#000000</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#176B55</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">#F4F7F5</item>
        <item name="android:windowBackground">#F4F7F5</item>
        <item name="android:textColorPrimary">#1A2B23</item>
        <item name="android:textColorSecondary">#63746B</item>
        <item name="android:buttonStyle">@style/LauncherDialogButton</item>
        <item name="android:alertDialogTheme">@style/LauncherDialogTheme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F7F5</item>
        <item name="android:navigationBarColor">#1A2B23</item>
    </style>
    <style name="LauncherDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#176B55</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="LauncherDialogTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#176B55</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">#1A2B23</item>
        <item name="android:textColorSecondary">#63746B</item>
        <item name="android:buttonStyle">@style/LauncherDialogButton</item>
        <item name="android:windowBackground">@drawable/launcher_dialog</item>
    </style>
    <style name="GamepadButton" />
</resources>
